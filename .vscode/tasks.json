{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cody-02: 상태 보기",
      "type": "process",
      "command": "node",
      "args": ["${workspaceFolder}/workers/cody-02/worker.mjs", "status"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "focus": false, "panel": "dedicated", "clear": true },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "cody-02: 연결 시험 (모델 사용량 발생)",
      "type": "process",
      "command": "node",
      "args": ["${workspaceFolder}/workers/cody-02/worker.mjs", "smoke"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "focus": false, "panel": "dedicated", "clear": true },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "cody-02: PM 작업 실행 (읽기 전용)",
      "type": "process",
      "command": "node",
      "args": ["${workspaceFolder}/workers/cody-02/worker.mjs", "run", "--task", "${input:cody02TaskFile}"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "focus": false, "panel": "dedicated", "clear": true },
      "runOptions": { "instanceLimit": 1 }
    }
  ],
  "inputs": [
    {
      "id": "cody02TaskFile",
      "type": "promptString",
      "description": "프로젝트 안의 PM 작업 지시 Markdown 경로입니다. 실행하면 Codex 사용량이 발생합니다.",
      "default": "workers/cody-02/requests/next-task.md"
    }
  ]
}
